# Copiar a .env y reemplazar los valores. No versionar .env.
MYSQL_DATABASE=wisp
MYSQL_USER=wisp
MYSQL_PASSWORD=cambia_esta_password
MYSQL_ROOT_PASSWORD=cambia_esta_root_password

# Dentro de Docker el host de MySQL es el servicio "db".
DB_URL=jdbc:mysql://db:3306/wisp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=wisp
DB_PASSWORD=cambia_esta_password

# Usuario administrador inicial (solo se crea si la tabla usuarios esta vacia).
WISP_ADMIN_USERNAME=ADMIN
WISP_ADMIN_PASSWORD=cambia_esta_password_admin

# Carga datos de prueba solo si la tabla clientes esta vacia.
WISP_SEED_DEMO=true
